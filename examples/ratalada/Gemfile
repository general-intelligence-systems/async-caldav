# frozen_string_literal: true

source "https://rubygems.org"

gem "async-caldav", "~> 1.2"

# Pinned explicitly, not left to async-caldav's own constraint: the released
# async-caldav still asks for `protocol-caldav ~> 1.0`, and 1.0.3 carries the
# scampi 0.x `test do` blocks that blow up as `Kernel#test` on load.
gem "protocol-caldav", "~> 1.1"
gem "ratalada", "~> 1.0"
gem "falcon", "~> 0.55.5"

# ratalada 1.0 builds its falcon environment against async-service 0.24; 0.25
# added a `root` lookup the environment does not answer, and falcon 0.57 turns
# that into a hard failure at startup.
gem "async-service", "~> 0.24.1"
