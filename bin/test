#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
EXAMPLE_DIR="$ROOT_DIR/examples/ratalada"

# --- Unit tests ---
echo "=== Unit tests ==="
bundle exec scampi
echo ""

# --- Integration tests ---
echo "=== Integration tests ==="

DATA_DIR="$(mktemp -d)"
SERVER_PID=""

cleanup() {
  if [ -n "$SERVER_PID" ]; then
    echo ""
    echo "Shutting down server..."
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  rm -rf "$DATA_DIR"
}
trap cleanup EXIT

# The example depends on the published async-caldav, like any other user of
# the gem. -I puts this working tree ahead of it so the integration suite
# exercises the code you are editing, not the release.
# Its own BUNDLE_PATH and BUNDLE_BIN: the example installs the released
# async-caldav, and a shared gem dir would overwrite the path-source stub this
# repo's own bundle resolves `gemspec` to -- and shared binstubs would get
# rewritten to point BUNDLE_GEMFILE at the example.
(
  cd "$EXAMPLE_DIR"
  export BUNDLE_GEMFILE="$EXAMPLE_DIR/Gemfile"
  export BUNDLE_PATH="$EXAMPLE_DIR/.gem"
  export BUNDLE_BIN="$EXAMPLE_DIR/.gem/bin"
  bundle install --quiet
  CALDAV_DATA_DIR="$DATA_DIR" HOST=127.0.0.1 PORT=9292 \
    RUBYOPT="-I$ROOT_DIR/lib" exec bundle exec ruby server.rb
) &
SERVER_PID=$!

# Wait for server to be ready (OPTIONS / doesn't require auth)
echo "Waiting for server..."
for i in $(seq 1 30); do
  if curl -sf -o /dev/null -X OPTIONS http://localhost:9292/ 2>/dev/null; then
    echo "Server ready."
    break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "Server exited before becoming ready"
    exit 1
  fi
  if [ "$i" -eq 30 ]; then
    echo "Server failed to start within 30s"
    exit 1
  fi
  sleep 1
done

"$SCRIPT_DIR/integration"
